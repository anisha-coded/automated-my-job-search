# Comma-separated public Greenhouse board slugs, for example: stripe,figma
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
PORT=3001
SEARCH_INTERVAL_MINUTES=30
POSTED_WITHIN_HOURS=24
# Optional Apify sources (use actors and inputs permitted by the relevant site's terms).
APIFY_API_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=
APIFY_LINKEDIN_INPUT_JSON=
APIFY_INDEED_ACTOR_ID=
APIFY_INDEED_INPUT_JSON=
# Additional compatible Apify actor sources as JSON, e.g. [{"source":"ZipRecruiter","actorId":"owner~actor","input":{}}]
APIFY_OTHER_SOURCES=[]
APIFY_MAX_ITEMS=500
APIFY_MAX_TOTAL_CHARGE_USD=5
# Enable only after verifying the applicable job site's terms permit automation.
ENABLE_BROWSER_APPLICATIONS=false
